# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Credentials (Client-side Publishable Key & Project URL)
# Used for Admin Auth, Portfolio Project Management, Client Management & Notes
VITE_SUPABASE_URL="https://your-project.supabase.co"
# Razorpay Credentials (Test Mode for development, Live Mode for production)
# Server-side secrets: NEVER prefix with VITE_ or expose to client
RAZORPAY_KEY_ID="rzp_test_yourKeyIdHere"
RAZORPAY_KEY_SECRET="yourRazorpayKeySecretHere"

# Client-side public key (Optional fallback for checkout initialization)
VITE_RAZORPAY_KEY_ID="rzp_test_yourKeyIdHere"
